{
  "name": "telegram-bot-template",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "description": "GrammY bot starter template",
  "author": "Flynn Cao",
  "license": "MIT",
  "main": "./build/index.js",
  "imports": {
    "#root/*": "./build/src/*"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  },
  "scripts": {
    "start:local": "node ./build/index.js",
    "dev:local": "tsup --watch --onSuccess \"node ./build/index.js\"",
    "build:local": "tsup",
    "build": "tsup",
    "deploy": "wrangler deploy",
    "dev": "wrangler dev",
    "start": "wrangler dev",
    "test": "vitest",
    "cf-typegen": "wrangler types"
  },
  "dependencies": {
    "@grammyjs/auto-retry": "^2.0.2",
    "@grammyjs/conversations": "^2.1.1",
    "@grammyjs/menu": "^1.3.1",
    "@grammyjs/storage-mongodb": "^2.5.1",
    "@typegoose/typegoose": "^12.21.0",
    "axios": "^1.13.2",
    "chalk": "^5.6.2",
    "dotenv": "^16.6.1",
    "easytimer.js": "^4.6.0",
    "grammy": "^1.39.2",
    "mongodb": "^6.21.0",
    "mongoose": "^8.21.0",
    "node-fetch": "^3.3.2",
    "socks-proxy-agent": "^8.0.5",
    "tsx": "3.14.0"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^1.2.1",
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@swc/core": "^1.15.8",
    "@types/node": "^20.19.29",
    "concurrently": "^8.2.2",
    "eslint": "^8.57.1",
    "husky": "8.0.3",
    "lint-staged": "14.0.1",
    "nodemon": "^3.1.11",
    "tsc-watch": "^6.3.1",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "~3.2.0",
    "wrangler": "^4.59.1"
  }
}
